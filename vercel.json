{
  "framework": null,
  "buildCommand": "node tools/build_vercel.cjs",
  "outputDirectory": "_site",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tvstextile.com"
        }
      ],
      "destination": "https://www.tvstextile.com/:path*",
      "permanent": true
    },
    {
      "source": "/kategori/banyo.html",
      "destination": "/collections/hotel-spa-textiles.html",
      "permanent": true
    },
    {
      "source": "/kategori/beach-spa.html",
      "destination": "/collections/hotel-spa-textiles.html",
      "permanent": true
    },
    {
      "source": "/kategori/bebek-cocuk.html",
      "destination": "/collections/baby-textiles.html",
      "permanent": true
    },
    {
      "source": "/kategori/yatak-takimi.html",
      "destination": "/collections/home-textiles.html",
      "permanent": true
    },
    {
      "source": "/kategori/ev-kiyafeti.html",
      "destination": "/collections/home-textiles.html",
      "permanent": true
    },
    {
      "source": "/kategori/yasam.html",
      "destination": "/collections/home-textiles.html",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang(fr|de|es)/index.html",
      "destination": "/:lang/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin/api/quotes",
      "destination": "/api/enquiries"
    },
    {
      "source": "/cms-media/:name",
      "destination": "/api/media?name=:name"
    }
  ],
  "functions": {
    "api/admin.js": {
      "includeFiles": "data/cms-seed.json",
      "maxDuration": 30
    },
    "api/enquiries.js": {
      "maxDuration": 60
    }
  }
}
